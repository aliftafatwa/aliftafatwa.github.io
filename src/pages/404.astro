---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Page Not Found | Al-Fatwa Archive</title>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col justify-center items-center text-center px-4">
    <div class="max-w-md bg-white p-8 rounded-xl border border-slate-200 shadow-sm space-y-4">
      <h1 class="text-5xl font-extrabold text-emerald-800">404</h1>
      <h2 class="text-xl font-bold text-slate-800">Page Not Found</h2>
      <p class="text-slate-600 text-sm">
        The fatwa or page you are looking for might have been moved or does not exist.
      </p>
      <a 
        href="/" 
        class="inline-block bg-emerald-700 hover:bg-emerald-800 text-white font-medium px-5 py-2.5 rounded-lg text-sm transition-colors"
      >
        Return to Homepage
      </a>
    </div>
  </body>
</html>