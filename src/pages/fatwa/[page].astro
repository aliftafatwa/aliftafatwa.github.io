---
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import '../../styles/global.css';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allFatwas = await getCollection('fatwa');
  // Sort by date descending (newest first)
  const sortedFatwas = allFatwas.sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
  );

  return paginate(sortedFatwas, { pageSize: 5 });
}

const { page } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fatwa Directory - Page {page.currentPage}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans">
    
    <header class="bg-emerald-900 text-white shadow-md border-b border-emerald-800 py-4 px-4">
      <div class="max-w-4xl mx-auto flex justify-between items-center">
        <a href="/" class="text-xl font-bold text-amber-300">Al-Fatwa Archive</a>
        <span class="text-xs text-emerald-200">Page {page.currentPage} of {page.lastPage}</span>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8 flex-grow w-full space-y-6">
      
      <div class="flex justify-between items-center border-b border-slate-200 pb-3">
        <h1 class="text-xl font-bold text-slate-800">All Islamic Rulings & Q&A</h1>
        <span class="text-xs text-slate-500">Showing {page.data.length} of {page.total} items</span>
      </div>

      <!-- Fatwa Cards List -->
      <div class="space-y-4">
        {page.data.map((fatwa) => (
          <article class="bg-white p-5 rounded-lg border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
              <span class="bg-emerald-50 text-emerald-700 font-semibold px-2 py-0.5 rounded border border-emerald-200">
                {fatwa.data.category}
              </span>
              <span>Fatwa #{fatwa.data.idNumber} • {new Date(fatwa.data.date).toLocaleDateString()}</span>
            </div>

            <h2 class="text-lg font-bold text-slate-900 mb-2 hover:text-emerald-700">
              <a href={`/fatwa/${fatwa.slug}/`}>{fatwa.data.title}</a>
            </h2>

            <p class="text-slate-600 text-sm mb-3 line-clamp-2">
              {fatwa.data.summary}
            </p>

            <div class="flex justify-between items-center text-xs border-t border-slate-100 pt-3">
              <span class="text-slate-500">Issued by: <strong class="text-slate-700">{fatwa.data.scholar}</strong></span>
              <a href={`/fatwa/${fatwa.slug}/`} class="text-emerald-700 font-medium hover:underline">
                Read Full Ruling &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Pagination Controls -->
      <nav class="flex items-center justify-between border-t border-slate-200 pt-6">
        <div>
          {page.url.prev ? (
            <a href={page.url.prev} class="px-4 py-2 bg-white border border-slate-300 rounded-md text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
              &larr; Previous Page
            </a>
          ) : (
            <span class="px-4 py-2 bg-slate-100 border border-slate-200 rounded-md text-xs text-slate-400 cursor-not-allowed">
              &larr; Previous Page
            </span>
          )}
        </div>

        <span class="text-xs text-slate-600">
          Page <strong>{page.currentPage}</strong> of <strong>{page.lastPage}</strong>
        </span>

        <div>
          {page.url.next ? (
            <a href={page.url.next} class="px-4 py-2 bg-white border border-slate-300 rounded-md text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
              Next Page &rarr;
            </a>
          ) : (
            <span class="px-4 py-2 bg-slate-100 border border-slate-200 rounded-md text-xs text-slate-400 cursor-not-allowed">
              Next Page &rarr;
            </span>
          )}
        </div>
      </nav>

    </main>

    <footer class="bg-slate-900 text-slate-400 py-6 text-xs text-center border-t border-slate-800">
      &copy; {new Date().getFullYear()} Al-Fatwa Archive. Hosted on GitHub Pages.
    </footer>

  </body>
</html>